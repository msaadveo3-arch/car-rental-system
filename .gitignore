```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/
out/

# Environment variables
.env
.env.local
.env.*

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Temporary files
*.tmp

# Python specific (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# Coverage reports
coverage/
htmlcov/

# Local configuration
*.local
.settings/

# OS generated files
.DS_Store
Thumbs.db

# Compiled assets
*.min.js
*.min.css
*.bundle.js
*.bundle.css

# Database
*.db
*.sqlite
*.sqlite3

# Package manager caches
.yarn-cache/
.npm/
.bower-cache/

# Testing
.nyc_output/
coverage/

# Runtime data
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compression
*.zip
*.tar.gz
*.tar
*.gz
*.7z
*.rar
*.bz2
*.xz
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo

# Images (not ignored as they might be part of the project)
# *.png
# *.jpg
# *.jpeg
# *.bmp
# *.gif
# *.webm
```